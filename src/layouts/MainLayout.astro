---
import "../styles/global.css";
const { title = "Portfolio" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <!-- Logo et menu hamburger en position fixed -->
    <a href="/" class="logo-fixed">CLEMENT LOYER</a>

    <nav class="nav-fixed">
      <a href="/projects">PROJECTS</a>
      <a href="/experience">EXPERIENCE</a>
      <a href="/contact">CONTACT</a>
    </nav>

    <!-- Contenu de la page -->
    <main class="content">
      <slot />
    </main>
  </body>
</html>
